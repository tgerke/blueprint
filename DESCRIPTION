Package: blueprint
Title: Sample Size, Power, and Simulation for Clinical Trial Designs
Version: 0.0.0.9000
Authors@R: 
    c(person("Travis", "Gerke", , "tgerke@mail.harvard.edu", role = c("aut", "cre", "cph"),
